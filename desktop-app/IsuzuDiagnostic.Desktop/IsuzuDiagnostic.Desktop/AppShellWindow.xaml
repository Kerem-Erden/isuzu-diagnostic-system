<Window x:Class="IsuzuDiagnostic.Desktop.AppShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isuzu Diagnostic System"
        Width="1150"
        Height="740"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation area -->
        <Border Grid.Column="0"
                Background="#A5001E">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Application title -->
                <StackPanel Grid.Row="0">

                    <TextBlock Text="ISUZU"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="Diagnostic System"
                               Margin="0,4,0,0"
                               Foreground="#E8E8E8"
                               FontSize="14"/>

                </StackPanel>

                <!-- Navigation buttons will be added here -->
                <StackPanel Grid.Row="2">

                    <Button Content="Vehicle Connection"
                            Height="44"
                            Margin="0,0,0,10"/>

                    <Button Content="Dashboard"
                            Height="44"
                            Margin="0,0,0,10"
                            IsEnabled="False"/>

                    <Button Content="Live Data"
                            Height="44"
                            Margin="0,0,0,10"
                            IsEnabled="False"/>

                    <Button Content="DTCs"
                            Height="44"
                            IsEnabled="False"/>

                    <Button Content="Developer Console"
                            Height="44"
                            Margin="0,10,0,0"
                            Click="DeveloperConsoleButton_Click"/>

                </StackPanel>

                <TextBlock Grid.Row="3"
                           Text="Prototype v0.1"
                           Foreground="#DDDDDD"
                           FontSize="12"/>

            </Grid>
        </Border>

        <!-- Main application area -->
        <Grid Grid.Column="1"
              Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">

                <TextBlock x:Name="PageTitleTextBlock"
                           Text="Vehicle Connection"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#30343B"/>

                <!-- Temporary logo placeholder -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinWidth="180"
                        Padding="18,9"
                        BorderBrush="#A5001E"
                        BorderThickness="2"
                        CornerRadius="6">

                    <TextBlock Text="ISUZU"
                               HorizontalAlignment="Center"
                               Foreground="#A5001E"
                               FontSize="21"
                               FontWeight="Bold"/>

                </Border>

            </Grid>

            <!-- Current screen -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#D5D8DE"
                    BorderThickness="1"
                    CornerRadius="10">

                <ContentControl x:Name="MainContent"/>

            </Border>

        </Grid>

    </Grid>

</Window>
