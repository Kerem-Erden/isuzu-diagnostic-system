<UserControl x:Class="IsuzuDiagnostic.Desktop.Views.DtcDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="{Binding Code, Mode=OneWay}"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#A5001E"/>

            <TextBlock Text="{Binding Description, Mode=OneWay}"
                       Margin="0,8,0,0"
                       FontSize="17"
                       TextWrapping="Wrap"/>

        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <Border Padding="20"
                        Margin="0,0,0,14"
                        Background="#F8F9FA"
                        BorderBrush="#D5D8DE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel>

                        <TextBlock Text="Status"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding Status, Mode=OneWay}"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <Border Padding="20"
                        Margin="0,0,0,14"
                        Background="#F8F9FA"
                        BorderBrush="#D5D8DE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel>

                        <TextBlock Text="Possible Causes"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>

                        <ItemsControl ItemsSource="{Binding PossibleCauses, Mode=OneWay}"
                                      Margin="0,10,0,0">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <TextBlock Text="{Binding Description, Mode=OneWay}"
                                               Margin="0,3,0,3"
                                               TextWrapping="Wrap"/>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </StackPanel>

                </Border>

                <Border Padding="20"
                        Margin="0,0,0,14"
                        Background="#F8F9FA"
                        BorderBrush="#D5D8DE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel>

                        <TextBlock Text="Diagnostic Steps"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>  

                        <ItemsControl ItemsSource="{Binding DiagnosticSteps, Mode=OneWay}"
                                      Margin="0,10,0,0">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Grid Margin="0,4,0,4">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Order, Mode=OneWay}"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Description, Mode=OneWay}"
                                                   TextWrapping="Wrap"/>

                                    </Grid>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <Border Padding="20"
                        Margin="0,0,0,14"
                        Background="#F8F9FA"
                        BorderBrush="#D5D8DE"
                        BorderThickness="1"
                        CornerRadius="8">   

                    <StackPanel>

                        <TextBlock Text="Possible Solutions"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>

                        <ItemsControl ItemsSource="{Binding PossibleSolutions, Mode=OneWay}"
                                      Margin="0,10,0,0">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <TextBlock Text="{Binding Description, Mode=OneWay}"
                                               Margin="0,3,0,3"
                                               TextWrapping="Wrap"/>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <Border Padding="20"
                        Background="#F8F9FA"
                        BorderBrush="#D5D8DE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel>

                        <TextBlock Text="Related Live Data"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>

                        <ItemsControl ItemsSource="{Binding RelatedLiveData, Mode=OneWay}"
                                      Margin="0,10,0,0">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Grid Margin="0,3,0,3">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Unit, Mode=OneWay}"
                                                   Foreground="#68707C"/>

                                    </Grid>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <StackPanel Grid.Row="4"
            Orientation="Horizontal">

            <Button Width="190"
            Height="40"
            Content="Show Related Live Data"
            Click="ShowRelatedLiveDataButton_Click"/>

            <Button Width="130"
            Height="40"
            Margin="10,0,0,0"
            Content="Back"
            Click="BackButton_Click"/>

        </StackPanel>

    </Grid>

</UserControl>