<UserControl x:Class="IsuzuDiagnostic.Desktop.Views.DtcDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock x:Name="DtcCodeTextBlock"
                       Text="DTC"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#A5001E"/>

            <TextBlock x:Name="DtcDescriptionTextBlock"
                       Margin="0,8,0,0"
                       FontSize="17"
                       TextWrapping="Wrap"/>

        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <Border Padding="20"
                        Margin="0,0,0,14"
                        Background="#F8F9FA"
                        BorderBrush="#D5D8DE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel>

                        <TextBlock Text="Status"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="DtcStatusTextBlock"
                                   Text="Unknown"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <Border Padding="20"
                        Margin="0,0,0,14"
                        Background="#F8F9FA"
                        BorderBrush="#D5D8DE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel>

                        <TextBlock Text="Possible Causes"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="PossibleCausesTextBlock"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <Border Padding="20"
                        Background="#F8F9FA"
                        BorderBrush="#D5D8DE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel>

                        <TextBlock Text="Related Live Data"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="RelatedLiveDataTextBlock"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <Button Grid.Row="4"
                Width="130"
                Height="40"
                HorizontalAlignment="Left"
                Content="Back"
                Click="BackButton_Click"/>

    </Grid>

</UserControl>