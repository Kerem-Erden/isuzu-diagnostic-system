<UserControl x:Class="IsuzuDiagnostic.Desktop.Views.DtcListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="Diagnostic Trouble Codes"
                       FontSize="30"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Detected codes are currently simulated for navigation testing."
                       Margin="0,8,0,0"
                       FontSize="15"
                       Foreground="#68707C"/>

        </StackPanel>

        <ScrollViewer Grid.Row="2"
              VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="DtcItemsControl">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Margin="0,0,0,12"
                        Padding="20"
                        BorderBrush="#D5D8DE"
                        BorderThickness="1"
                        CornerRadius="8">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="{Binding Code}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#A5001E"/>

                                    <TextBlock Text="{Binding Description}"
                                       Margin="0,6,20,0"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Status, Mode=OneWay, StringFormat='Status: {0}'}"
                                               Margin="0,8,0,0"
                                               Foreground="#68707C"/>   

                                </StackPanel>

                                <Button Grid.Column="1"
                                Width="110"
                                Height="38"
                                VerticalAlignment="Center"
                                Content="Details"
                                Tag="{Binding }"
                                Click="DetailsButton_Click"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal">

            <Button Width="130"
            Height="40"
            Content="Rescan"
            Click="RescanButton_Click"/>

            <Button Width="180"
            Height="40"
            Margin="10,0,0,0"
            Content="Clear DTC Memory"
            Click="ClearDtcMemoryButton_Click"/>

            <Button Width="130"
            Height="40"
            Margin="10,0,0,0"
            Content="Back"
            Click="BackButton_Click"/>

        </StackPanel>

    </Grid>

</UserControl>