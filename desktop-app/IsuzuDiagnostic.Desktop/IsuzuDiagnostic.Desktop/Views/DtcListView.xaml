<UserControl x:Class="IsuzuDiagnostic.Desktop.Views.DtcListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="Diagnostic Trouble Codes"
                       FontSize="30"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Detected codes are currently simulated for navigation testing."
                       Margin="0,8,0,0"
                       FontSize="15"
                       Foreground="#68707C"/>

        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- Mock DTC: P003A -->
                <Border Margin="0,0,0,12"
                        Padding="20"
                        BorderBrush="#D5D8DE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="P003A"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#A5001E"/>

                            <TextBlock Text="Turbocharger boost control position exceeded learning limit"
                                       Margin="0,6,20,0"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Status: Active"
                                       Margin="0,8,0,0"
                                       Foreground="#68707C"/>

                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="110"
                                Height="38"
                                VerticalAlignment="Center"
                                Content="Details"
                                Tag="P003A"
                                Click="DetailsButton_Click"/>

                    </Grid>

                </Border>

                <!-- Mock DTC: P2080 -->
                <Border Padding="20"
                        BorderBrush="#D5D8DE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="P2080"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#A5001E"/>

                            <TextBlock Text="Exhaust gas temperature sensor circuit range/performance"
                                       Margin="0,6,20,0"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Status: Stored"
                                       Margin="0,8,0,0"
                                       Foreground="#68707C"/>

                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="110"
                                Height="38"
                                VerticalAlignment="Center"
                                Content="Details"
                                Tag="P2080"
                                Click="DetailsButton_Click"/>

                    </Grid>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <Button Grid.Row="4"
                Width="130"
                Height="40"
                HorizontalAlignment="Left"
                Content="Back"
                Click="BackButton_Click"/>

    </Grid>

</UserControl>