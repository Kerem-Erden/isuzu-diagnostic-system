<UserControl x:Class="IsuzuDiagnostic.Desktop.Views.LiveDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="Live Data"
                       FontSize="30"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Live vehicle parameters will be displayed on this screen."
                       Margin="0,8,0,0"
                       FontSize="15"
                       Foreground="#68707C"/>

            <TextBlock x:Name="LastReceivedTextBlock"
                       Text="Last received: No data received yet"
                       Margin="0,8,0,0"
                       FontSize="13"
                       Foreground="#68707C"/>   

        </StackPanel>

        <UniformGrid Grid.Row="2"
                     Columns="3">

            <Border Margin="8"
                    Padding="20"
                    BorderBrush="#D5D8DE"
                    BorderThickness="1"
                    CornerRadius="8">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Engine RPM"
                               HorizontalAlignment="Center"
                               FontSize="15"/>

                    <TextBlock x:Name="RpmValueTextBlock"
                               Text="--"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               FontSize="32"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="rpm"
                               HorizontalAlignment="Center"
                               Foreground="#68707C"/>

                </StackPanel>

            </Border>

            <Border Margin="8"
                    Padding="20"
                    BorderBrush="#D5D8DE"
                    BorderThickness="1"
                    CornerRadius="8">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Coolant Temperature"
                               HorizontalAlignment="Center"
                               FontSize="15"/>

                    <TextBlock x:Name="CoolantValueTextBlock"
                               Text="--"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               FontSize="32"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="°C"
                               HorizontalAlignment="Center"
                               Foreground="#68707C"/>

                </StackPanel>

            </Border>

            <Border Margin="8"
                    Padding="20"
                    BorderBrush="#D5D8DE"
                    BorderThickness="1"
                    CornerRadius="8">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Battery Voltage"
                               HorizontalAlignment="Center"
                               FontSize="15"/>

                    <TextBlock x:Name="BatteryValueTextBlock"
                               Text="--"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               FontSize="32"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="V"
                               HorizontalAlignment="Center"
                               Foreground="#68707C"/>

                </StackPanel>

            </Border>

        </UniformGrid>

        <Button Grid.Row="4"
                Width="130"
                Height="40"
                HorizontalAlignment="Left"
                Content="Back"
                Click="BackButton_Click"/>

    </Grid>

</UserControl>