<UserControl x:Class="IsuzuDiagnostic.Desktop.Views.LiveDataView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="30">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Live Data" FontSize="30" FontWeight="SemiBold"/>
   <TextBlock x:Name="SourceText" Margin="0,8" FontWeight="Bold" Foreground="#A5001E"/>
   <TextBlock x:Name="RelatedText" TextWrapping="Wrap" Margin="0,4"/>
   <StackPanel Orientation="Horizontal" Margin="0,8">
    <TextBlock Text="Reference operating condition: " VerticalAlignment="Center"/>
    <ComboBox x:Name="ConditionCombo" Width="280" SelectionChanged="ConditionChanged"/>
   </StackPanel>
   <TextBlock x:Name="PolicyText" TextWrapping="Wrap" Foreground="#68707C"/>
   <TextBlock x:Name="LastReceivedTextBlock" Margin="0,8" Text="Waiting for fresh data" TextWrapping="Wrap"/>
  </StackPanel>
  <DataGrid x:Name="ValuesGrid" Grid.Row="1" Margin="0,15" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="*"/>
    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100"/>
    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="65"/>
    <DataGridTextColumn Header="Assessment" Binding="{Binding State}" Width="160"/>
    <DataGridTextColumn Header="Received" Binding="{Binding Received}" Width="100"/>
   </DataGrid.Columns>
  </DataGrid>
  <Button Grid.Row="2" Width="130" Height="40" HorizontalAlignment="Left" Content="Back" Click="BackButton_Click"/>
 </Grid>
</UserControl>
