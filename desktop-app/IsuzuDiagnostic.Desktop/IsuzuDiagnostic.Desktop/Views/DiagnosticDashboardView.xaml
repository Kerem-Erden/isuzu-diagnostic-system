<UserControl x:Class="IsuzuDiagnostic.Desktop.Views.DiagnosticDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="Diagnostic Dashboard"
                       FontSize="30"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Isuzu NPR 66 — 4JZ1 — 2018"
                       Margin="0,8,0,0"
                       FontSize="15"
                       Foreground="#68707C"/>

        </StackPanel>

        <UniformGrid Grid.Row="2"
                     Columns="3">

            <Button Margin="8"
                    Content="Live Data"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Click="LiveDataButton_Click"/>

            <Button Margin="8"
                    Content="Read DTCs"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Click="ReadDtcsButton_Click"/>

            <Button Margin="8"
                    Content="Vehicle Information"
                    FontSize="18"
                    FontWeight="SemiBold"/>

        </UniformGrid>

        <Button Grid.Row="4"
                Width="160"
                Height="40"
                HorizontalAlignment="Left"
                Content="End Session"
                Click="EndSessionButton_Click"/>

    </Grid>

</UserControl>