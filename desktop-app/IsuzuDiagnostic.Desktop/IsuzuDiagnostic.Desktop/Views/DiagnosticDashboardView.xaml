<UserControl x:Class="IsuzuDiagnostic.Desktop.Views.DiagnosticDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="Diagnostic Dashboard"
                       FontSize="30"
                       FontWeight="SemiBold"/>

            <StackPanel Margin="0,8,0,0">

                <TextBlock Text="{Binding Vehicle.DisplayName, Mode=OneWay}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#30323B"/>

                <TextBlock Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="#68707C">

                <Run Text="ECU: "/>
                <Run Text="{Binding Vehicle.EcuType, Mode=OneWay}"/>

                <Run Text="   •   Port: "/>
                <Run Text="{Binding SerialPortName, Mode=OneWay}"/>

                <Run Text="   •   State: "/>
                <Run Text="{Binding State, Mode=OneWay}"/>

                </TextBlock>

            </StackPanel>

        </StackPanel>

        <UniformGrid Grid.Row="2"
                     Columns="3">

            <Button Margin="8"
                    Content="Live Data"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Click="LiveDataButton_Click"/>

            <Button Margin="8"
                    Content="Read DTCs"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Click="ReadDtcsButton_Click"/>

            <Button Margin="8"
                    Content="Vehicle Information"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Click="VehicleInformationButton_Click"/>

        </UniformGrid>

        <Button Grid.Row="4"
                Width="160"
                Height="40"
                HorizontalAlignment="Left"
                Content="End Session"
                Click="EndSessionButton_Click"/>
    </Grid>

</UserControl>