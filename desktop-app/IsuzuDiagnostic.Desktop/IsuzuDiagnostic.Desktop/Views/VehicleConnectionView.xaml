<UserControl x:Class="IsuzuDiagnostic.Desktop.Views.VehicleConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40">

        <Grid MaxWidth="720"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Screen heading -->
            <StackPanel Grid.Row="0">

                <TextBlock Text="Connect to Vehicle"
                           FontSize="30"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Select the vehicle information and diagnostic gateway connection."
                           Margin="0,8,0,0"
                           FontSize="15"
                           Foreground="#68707C"
                           TextWrapping="Wrap"/>

            </StackPanel>

            <!-- Vehicle selection form -->
            <Border Grid.Row="2"
                    Padding="28"
                    Background="#F8F9FA"
                    BorderBrush="#D5D8DE"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Manufacturer"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Text="Isuzu"
                             Height="36"
                             Padding="10,6"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Vehicle model"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="VehicleModelComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Height="36"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">

                        <ComboBoxItem Content="NPR 71"/>
                        <ComboBoxItem Content="NPR 75"/>
                        <ComboBoxItem Content="NNR"/>
                        <ComboBoxItem Content="NPR 10 Long"/>
                        <ComboBoxItem Content="NPR 8 Long"/>
                        <ComboBoxItem Content="NPR 3D"/>
                        <ComboBoxItem Content="NQR 71"/>
                        <ComboBoxItem Content="Other / Test Profile"/>

                    </ComboBox>

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Model year"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="ModelYearComboBox"
                              Grid.Row="4"
                              Grid.Column="1"
                              Height="36"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">

                        <ComboBoxItem Content="2018"/>
                        <ComboBoxItem Content="2019"/>
                        <ComboBoxItem Content="2020"/>
                        <ComboBoxItem Content="2021"/>

                    </ComboBox>

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="Engine code"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="EngineCodeComboBox"
                              Grid.Row="6"
                              Grid.Column="1"
                              Height="36"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">

                        <ComboBoxItem Content="4JZ1"/>
                        <ComboBoxItem Content="4HK1"/>
                        <ComboBoxItem Content="RZ4E"/>
                        <ComboBoxItem Content="Test Engine"/>

                    </ComboBox>

                    <TextBlock Grid.Row="8"
                               Grid.Column="0"
                               Text="Diagnostic port"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="SerialPortComboBox"
                              Grid.Row="8"
                              Grid.Column="1"
                              Height="36"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">

                        <ComboBoxItem Content="COM3"/>
                        <ComboBoxItem Content="Prototype Connection"/>

                    </ComboBox>

                    <Button Grid.Row="10"
                            Grid.Column="1"
                            Width="180"
                            Height="42"
                            HorizontalAlignment="Right"
                            Content="Continue"
                            Background="#A5001E"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="ContinueButton_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>