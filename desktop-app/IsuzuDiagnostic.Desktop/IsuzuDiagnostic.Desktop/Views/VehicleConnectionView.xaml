<UserControl x:Class="IsuzuDiagnostic.Desktop.Views.VehicleConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40">

        <Grid MaxWidth="720"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Screen heading -->
            <StackPanel Grid.Row="0">

                <TextBlock Text="Connect to Vehicle"
                           FontSize="30"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Select the vehicle information and diagnostic gateway connection."
                           Margin="0,8,0,0"
                           FontSize="15"
                           Foreground="#68707C"
                           TextWrapping="Wrap"/>

            </StackPanel>

            <!-- Vehicle selection form -->
            <Border Grid.Row="2"
                    Padding="28"
                    Background="#F8F9FA"
                    BorderBrush="#D5D8DE"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0 Manufacturer -->
                        <RowDefinition Height="18"/> <!-- 1 Space -->

                        <RowDefinition Height="Auto"/> <!-- 2 Vehicle model -->
                        <RowDefinition Height="18"/> <!-- 3 Space -->

                        <RowDefinition Height="Auto"/> <!-- 4 Model year --> 
                        <RowDefinition Height="18"/> <!-- 5 Space -->

                        <RowDefinition Height="Auto"/> <!-- 6 Engine code -->
                        <RowDefinition Height="18"/> <!-- 7 Space -->
                       
                        <RowDefinition Height="Auto"/> <!-- 8 ECU type -->
                        <RowDefinition Height="18"/> <!-- 9 Space -->

                        <RowDefinition Height="Auto"/> <!-- 10 Diagnostic port -->
                        <RowDefinition Height="30"/> <!-- 11 Space -->
                        
                        <RowDefinition Height="Auto"/> <!-- 12 Continue button -->
                        
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Manufacturer"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Text="Isuzu"
                             Height="36"
                             Padding="10,6"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Vehicle model"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="VehicleModelComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Height="36"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">

                    </ComboBox>

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Model year"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="ModelYearComboBox"
                              Grid.Row="4"
                              Grid.Column="1"
                              Height="36"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">

                    </ComboBox>

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="Engine code"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="EngineCodeComboBox"
                              Grid.Row="6"
                              Grid.Column="1"
                              Height="36"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">
                    </ComboBox>
                    
                    <TextBlock Grid.Row="8"
                               Grid.Column="0"
                               Text="ECU type"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="EcuTypeComboBox"
                              Grid.Row="8"
                              Grid.Column="1"
                              Height="36"
                              IsEnabled="False"
                              VerticalContentAlignment="Center"/>


                    <TextBlock Grid.Row="10"
                               Grid.Column="0"
                               Text="Diagnostic port"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="SerialPortComboBox"
                              Grid.Row="10"
                              Grid.Column="1"
                              Height="36"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">

                        <ComboBoxItem Content="COM3"/>
                        <ComboBoxItem Content="Prototype Connection"/>

                    </ComboBox>

                    <Button Grid.Row="12"
                            Grid.Column="1"
                            Width="180"
                            Height="42"
                            HorizontalAlignment="Right"
                            Content="Continue"
                            Background="#A5001E"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="ContinueButton_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>