<UserControl x:Class="IsuzuDiagnostic.Desktop.Views.DeveloperConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="Developer Console"
                       FontSize="30"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Raw communication and diagnostic logs will be displayed here."
                       Margin="0,8,0,0"
                       FontSize="15"
                       Foreground="#68707C"/>

        </StackPanel>

        <TextBox Grid.Row="2"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Padding="16"
                 Background="#111827"
                 Foreground="#E5E7EB"
                 BorderThickness="0"
                 FontFamily="Consolas"
                 FontSize="13"
                 Text="[APP] Developer console initialized.&#x0a;[APP] Serial communication service is not attached yet."/>

        <Button Grid.Row="4"
                Width="130"
                Height="40"
                HorizontalAlignment="Left"
                Content="Back"
                Click="BackButton_Click"/>

    </Grid>

</UserControl>