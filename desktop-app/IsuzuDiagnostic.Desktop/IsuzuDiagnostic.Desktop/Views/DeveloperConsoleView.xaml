<UserControl x:Class="IsuzuDiagnostic.Desktop.Views.DeveloperConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- Gateway command buttons -->
        <Style x:Key="CommandButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="120"/>

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Margin"
                    Value="0,0,10,0"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#A5001E"/>

            <Setter Property="BorderBrush"
                    Value="#A5001E"/>

            <Setter Property="BorderThickness"
                    Value="1.5"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                        Value="True">

                    <Setter Property="Background"
                            Value="#FFF1F3"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- Secondary action -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="120"/>

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Background"
                    Value="#E8EAED"/>

            <Setter Property="Foreground"
                    Value="#30343B"/>

            <Setter Property="BorderBrush"
                    Value="#C7CBD1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

        <!-- Primary navigation action -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="120"/>

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Background"
                    Value="#A5001E"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                        Value="True">

                    <Setter Property="Background"
                            Value="#850018"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>

            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>

            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Developer Console"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Genarate and inspect diagnostic gateway protocol messages."
                       Margin="0,8,0,0"
                       FontSize="14"
                       Foreground="#68707C"
                       TextWrapping="Wrap"/>

        </StackPanel>

        <Border Grid.Row="2"
        Padding="14"
        Background="#F8F9FA"
        BorderBrush="#D5D8DE"
        BorderThickness="1"
        CornerRadius="6">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                   Text="Serial port"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"/>

                <ComboBox x:Name="SerialPortComboBox"
                  Grid.Column="1"
                  Height="36"
                  Margin="0,0,10,0"
                  VerticalContentAlignment="Center"/>

                <Button Grid.Column="2"
                Width="90"
                Height="36"
                Margin="0,0,10,0"
                Content="Refresh"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="RefreshPortsButton_Click"/>

                <Button x:Name="ConnectButton"
                Grid.Column="3"
                Width="90"
                Height="36"
                Margin="0,0,10,0"
                Content="Connect"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="ConnectButton_Click"/>

                <Button x:Name="DisconnectButton"
                Grid.Column="4"
                Width="100"
                Height="36"
                Content="Disconnect"
                IsEnabled="False"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="DisconnectButton_Click"/>

                <TextBlock x:Name="PortStatusTextBlock"
                   Grid.Column="5"
                   Margin="16,0,0,0"
                   Text="Disconnected"
                   VerticalAlignment="Center"
                   Foreground="#68707C"
                   FontWeight="SemiBold"/>

            </Grid>

        </Border>

        <!-- Command buttons -->
        <WrapPanel Grid.Row="4">

            <Button Content="PING"
                    Style="{StaticResource CommandButtonStyle}"
                    Click="PingButton_Click"/>

            <Button Content="START"
                    Style="{StaticResource CommandButtonStyle}"
                    Click="StartButton_Click"/>

            <Button Content="STOP"
                    Style="{StaticResource CommandButtonStyle}"
                    Click="StopButton_Click"/>

            <Button Content="STATUS"
                    Margin="0"
                    Style="{StaticResource CommandButtonStyle}"
                    Click="StatusButton_Click"/>
            
            <Button Content="TEST PARSER"
                    Width="140"
                    Margin="10,0,0,0"
                    Style="{StaticResource CommandButtonStyle}"
                    Click="TestParserButton_Click"/>

        </WrapPanel>

        <!-- Console output -->
        <Border Grid.Row="6"
        Background="#17191D"
        BorderBrush="#A5001E"
        BorderThickness="1"
        CornerRadius="6">

            <TextBox x:Name="ConsoleOutputTextBox"
                     Padding="14"
                     Background="Transparent"
                     Foreground="#E6E6E6"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="14"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>

        </Border>

        <!-- Bottom controls -->
        <Grid Grid.Row="8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
            Content="Clear"
            Style="{StaticResource SecondaryButtonStyle}"
            Click="ClearButton_Click"/>

            <Button Grid.Column="2"
            Content="Back"
            Style="{StaticResource PrimaryButtonStyle}"
            Click="BackButton_Click"/>

        </Grid>

    </Grid>

</UserControl>