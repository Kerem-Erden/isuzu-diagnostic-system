<Window x:Class="IsuzuDiagnostic.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isuzu Diagnostic System"
        Height="520"
        Width="800"
        MinHeight="420"
        MinWidth="650"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Application title -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Isuzu Diagnostic System"
                       FontSize="26"
                       FontWeight="SemiBold"/>

            <TextBlock Text="ESP32 diagnostic gateway connection"
                       Margin="0,6,0,0"
                       FontSize="14"
                       Opacity="0.70"/>
        </StackPanel>

        <!-- Serial connection controls -->
        <Border Grid.Row="2"
                Padding="16"
                BorderThickness="1"
                BorderBrush="Gray"
                CornerRadius="6">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Serial port:"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="PortComboBox"
                          Grid.Column="1"
                          Height="32"
                          VerticalContentAlignment="Center"/>

                <Button x:Name="RefreshPortsButton"
                        Grid.Column="2"
                        Content="Refresh"
                        Margin="10,0,0,0"
                        Padding="14,4"
                        Click="RefreshPortsButton_Click"/>

                <Button x:Name="ConnectButton"
                        Grid.Column="3"
                        Content="Connect"
                        Margin="10,0,0,0"
                        Padding="14,4"
                        Click="ConnectButton_Click"/>

                <Button x:Name="DisconnectButton"
                        Grid.Column="4"
                        Content="Disconnect"
                        Margin="10,0,0,0"
                        Padding="14,4"
                        IsEnabled="False"
                        Click="DisconnectButton_Click"/>

                <TextBlock x:Name="ConnectionStatusTextBlock"
                           Grid.Column="5"
                           Text="Disconnected"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>
        
        <!--Parsed live-data values -->
        <GroupBox Grid.Row="4"
                  Header="Live Data"
                  MinHeight="160">
            <UniformGrid Columns="3"
                         Margin="10">
                <!-- Engine RPM -->
                <Border Margin="5"
                        Padding="16"
                        BorderThickness="1"
                        BorderBrush="Gray"
                        CornerRadius="6">

                    <StackPanel>
                        <TextBlock Text="Engine RPM"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   Opacity="0.70"/>
                        <TextBlock x:Name="RpmValueTextBlock"
                                   HorizontalAlignment="Center"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"
                                   Text="--"/>
                        <TextBlock Text="RPM"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   Opacity="0.70"/>
                    </StackPanel>
                </Border>

                <!-- Coolant Temperature -->
                <!-- Coolant temperature -->
                <Border Margin="5"
                        Padding="16"
                        BorderThickness="1"
                        BorderBrush="Gray"
                        CornerRadius="6">

                    <StackPanel>
                        <TextBlock Text="Coolant temperature"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   Opacity="0.70"/>

                        <TextBlock x:Name="CoolantTemperatureValueTextBlock"
                                   Text="--"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="30"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="°C"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   Opacity="0.70"/>
                    </StackPanel>
                </Border>

                <!-- Battery voltage -->
                <Border Margin="5"
                        Padding="16"
                        BorderThickness="1"
                        BorderBrush="Gray"
                        CornerRadius="6">

                    <StackPanel>
                        <TextBlock Text="Battery voltage"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   Opacity="0.70"/>

                        <TextBlock x:Name="BatteryVoltageValueTextBlock"
                                   Text="--"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="30"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="V"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   Opacity="0.70"/>
                    </StackPanel>
                </Border>

            </UniformGrid>
        </GroupBox>


        <!-- Raw serial output -->
        <GroupBox Grid.Row="6"
                  Header="Raw serial output">

            <Grid Margin="10">
                <TextBox x:Name="SerialOutputTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="13"
                         TextWrapping="NoWrap"/>
            </Grid>
        </GroupBox>

    </Grid>
</Window>