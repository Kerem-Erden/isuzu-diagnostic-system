{
  "version": "2.0-draft",
  "principles": [
    "Use stable string keys in JSON; SQLite numeric IDs are generated by importer.",
    "Import sources/applications/modules/live parameters before dependent records.",
    "DTC lookup is global by code; application profiles are optional enrichment.",
    "Preserve source_reference on imported facts.",
    "Unknown code must not fail a diagnostic session."
  ],
  "recommended_import_order": [
    "sources.json",
    "applications.json",
    "control_modules.json",
    "networks.json",
    "control_module_pins.json",
    "dtcs.json",
    "dtc_profiles.json",
    "dtc_mappings.json",
    "live_parameters.json",
    "live_reference_values.json",
    "dtc_related_live_data.json",
    "service_specifications.json",
    "actuator_tests.json",
    "special_functions.json",
    "dtc_lifecycle_rules.json",
    "fault_classes.json",
    "symptom_troubleshooting.json"
  ],
  "suggested_tables": {
    "source_documents": "sources.json",
    "diagnostic_applications": "applications.json",
    "control_modules": "control_modules.json",
    "control_module_pins": "control_module_pins.json",
    "vehicle_networks": "networks.json",
    "dtc_codes": "dtcs.json",
    "dtc_profiles": "dtc_profiles.json",
    "dtc_mappings": "dtc_mappings.json",
    "live_parameters": "live_parameters.json",
    "live_reference_values": "live_reference_values.json",
    "dtc_related_live_data": "dtc_related_live_data.json",
    "service_specifications": "service_specifications.json",
    "actuator_tests": "actuator_tests.json",
    "special_functions": "special_functions.json",
    "dtc_lifecycle_rules": "dtc_lifecycle_rules.json",
    "fault_classes": "fault_classes.json",
    "symptom_troubleshooting": "symptom_troubleshooting.json"
  },
  "upsert_keys": {
    "source_documents": "document_key",
    "diagnostic_applications": "application_key",
    "control_modules": "(application_key,module_key)",
    "dtc_codes": "code",
    "dtc_profiles": "profile_key",
    "live_parameters": "parameter_key",
    "vehicle_networks": "(application_key,network_key)"
  }
}